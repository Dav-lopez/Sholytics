# ─── Contact Form ─────────────────────────────────────────────────────────────
# The form sends email through Resend (https://resend.com). Without RESEND_API_KEY
# it asks visitors to email management@sholytics.org instead of accepting messages.
# Verify sholytics.org as a sending domain in Resend, then set:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# CONTACT_TO=management@sholytics.org
# CONTACT_FROM=SHOLYTICS Website <contact@sholytics.org>

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://sholytics.org

# ─── Chat (SHOLYTICS Support) ─────────────────────────────────────────────────
# Address of the DrugAI app, which hosts the SHOLYTICS help desk. The chat button is
# hidden until this is set. The app allows sholytics.org and www.sholytics.org by default.
# NEXT_PUBLIC_SUPPORT_API_URL=https://app.sholytics.org
